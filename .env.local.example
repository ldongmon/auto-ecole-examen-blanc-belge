# Copier ce fichier en .env.local (jamais commité — voir .gitignore) et
# renseigner les valeurs réelles.

# Brevo : https://app.brevo.com > Settings (icône ⚙) > SMTP & API > API Keys
# > Generate a new API key.
BREVO_API_KEY=

# Optionnel : ID numérique d'une liste Brevo (Contacts > Lists > créer une
# liste "Examen Blanc Belge" > l'ID apparaît dans les paramètres de la liste).
# Si vide, les contacts sont créés/mis à jour sans être rattachés à une liste.
BREVO_LIST_ID=
